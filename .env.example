# Safe local-development placeholders only. Copy to .env and edit locally.
MISSUS_TOM_API_HOST=127.0.0.1
MISSUS_TOM_API_PORT=8000
MISSUS_TOM_STATE_DIR=/absolute/path/to/local/missus-tom-state
VITE_API_BASE_URL=http://127.0.0.1:8000
MISSUS_TOM_DEFAULT_PROJECT_DIR=/absolute/path/to/projects
MISSUS_TOM_REFERENCE_DIR=/absolute/path/to/references
# Controlled execution is off unless explicitly enabled by the local launcher.
MISSUS_TOM_EXECUTION_ENABLED=0
MISSUS_TOM_EXECUTION_ROOT=/absolute/path/to/restricted/demo-root
MISSUS_TOM_HUMAN_DEMO_MANIFEST=/absolute/path/to/restricted/demo-root/project/input_manifest/project_manifest.json
