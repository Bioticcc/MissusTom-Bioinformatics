{
  "name": "missus-tom-desktop",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test:coordinator && npm run test:setup-state && npm run test:api && npm run test:overlay && npm run test:run-lifecycle && npm run test:demo-assets && npm run test:live-command-log && npm run test:dashboard-demo && npm run test:tauri-config && npm run test:titlebar && npm run test:layout && npm run test:branding",
    "test:live-command-log": "node test/liveCommandLog.contract.test.mjs",
    "test:dashboard-demo": "node test/dashboardDemo.contract.test.mjs",
    "test:api": "node test/api.test.mjs",
    "test:coordinator": "node test/requestCoordinator.test.mjs",
    "test:setup-state": "node test/setupState.contract.test.mjs",
    "test:tauri-config": "node test/tauriConfig.contract.test.mjs",
    "test:titlebar": "node test/titlebar.contract.test.mjs",
    "test:layout": "node test/layout.contract.test.mjs",
    "test:branding": "node test/branding.contract.test.mjs",
    "test:demo-assets": "node test/pipelineDemoAssets.contract.test.mjs",
    "test:overlay": "node test/runOverlayState.test.mjs",
    "test:run-lifecycle": "node test/runLifecycle.contract.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "tauri": "tauri",
    "tauri:release": "tauri build --config src-tauri/tauri.release.conf.json --target x86_64-unknown-linux-gnu"
  },
  "dependencies": {
    "@tauri-apps/api": "2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "@tauri-apps/cli": "2.2.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.27.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.20.0",
    "vite": "6.4.3"
  }
}
