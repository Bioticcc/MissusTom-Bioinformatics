{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Missus Tom",
  "version": "0.3.0",
  "identifier": "org.yanlab.missustom",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Missus Tom",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Science",
    "shortDescription": "Local bulk RNA-seq project workbench",
    "longDescription": "Configure and validate Yan Lab bulk RNA-seq projects locally, with controlled execution for the internal human demo."
  }
}
