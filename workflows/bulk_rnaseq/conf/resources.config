process {
    cpus = { Math.min(2, params.max_cpus as Integer) }
    memory = { "${Math.min(4, params.max_memory_gb as Double)} GB" }

    withLabel: fastqc {
        container = 'quay.io/biocontainers/fastqc@sha256:e194048df39c3145d9b4e0a14f4da20b59d59250465b6f2a9cb698445fd45900'
        cpus = { Math.min(2, params.max_cpus as Integer) }
    }

    withLabel: multiqc {
        container = 'quay.io/biocontainers/multiqc@sha256:dfd9fde2c48b896b884e79a71ddc16c72c97a0ee5c5c8e45aaba50f55d07d263'
        cpus = 1
        memory = { "${Math.min(4, params.max_memory_gb as Double)} GB" }
    }

    withLabel: cutadapt {
        container = 'quay.io/biocontainers/cutadapt@sha256:c96a44c18f58660e853652c7efb303b3f426aa12f1ee7af007d03a54c39b87a5'
        cpus = { Math.min(4, params.max_cpus as Integer) }
    }

    withLabel: kallisto {
        container = 'quay.io/biocontainers/kallisto@sha256:7615f563aa2948fd087f7e4a666e252f275c60b2070729bc9a3804c8873527e5'
        cpus = { Math.min(4, params.max_cpus as Integer) }
        memory = { "${Math.min(8, params.max_memory_gb as Double)} GB" }
        // glibc reports Kallisto native memory aborts as 134; retry once before failing.
        errorStrategy = { task.exitStatus in [134, 139] ? 'retry' : 'terminate' }
        maxRetries = 1
    }

    withLabel: analysis {
        container = 'missus-tom/rnaseq-analysis:0.3.0'
        cpus = { Math.min(4, params.max_cpus as Integer) }
        memory = { "${Math.min(16, params.max_memory_gb as Double)} GB" }
    }
}
