/*
 * =============================================================================
 * BULK RNA-SEQ PROCESS RESOURCE SETTINGS
 * =============================================================================
 * PURPOSE: Sets existing CPU, memory, retry, and container settings for each
 * process defined in main.nf. It is loaded by nextflow.config before a run.
 * INPUTS: workflow-wide max_cpus and max_memory_gb parameters.
 * OUTPUTS: scheduler requests and, when enabled, pinned container images.
 * TERMS: CPU and memory are task limits; a container is a packaged tool image.
 * =============================================================================
 */

// =============================================================================
// SECTION 1: DEFAULTS AND QUALITY-CONTROL TASKS
// =============================================================================
process {
    // APPENDIX: 1.1
    cpus = { Math.min(2, params.max_cpus as Integer) }
    memory = { "${Math.min(4, params.max_memory_gb as Double)} GB" }

    withLabel: fastqc {
        // APPENDIX: 1.2
        container = 'quay.io/biocontainers/fastqc@sha256:e194048df39c3145d9b4e0a14f4da20b59d59250465b6f2a9cb698445fd45900'
        cpus = { Math.min(2, params.max_cpus as Integer) }
        // Native JVM failures retry once; main.nf isolates each read in a one-thread JVM.
        errorStrategy = { task.exitStatus in [134, 139] ? 'retry' : 'terminate' }
        maxRetries = 1
    }

    withLabel: multiqc {
        // APPENDIX: 1.3
        container = 'quay.io/biocontainers/multiqc@sha256:dfd9fde2c48b896b884e79a71ddc16c72c97a0ee5c5c8e45aaba50f55d07d263'
        cpus = 1
        memory = { "${Math.min(4, params.max_memory_gb as Double)} GB" }
    }

    // =============================================================================
    // SECTION 2: TRIMMING, QUANTIFICATION, AND R ANALYSIS TASKS
    // =============================================================================
    withLabel: cutadapt {
        // APPENDIX: 2.1
        container = 'quay.io/biocontainers/cutadapt@sha256:c96a44c18f58660e853652c7efb303b3f426aa12f1ee7af007d03a54c39b87a5'
        cpus = { Math.min(4, params.max_cpus as Integer) }
    }

    withLabel: kallisto {
        // APPENDIX: 2.2
        container = 'quay.io/biocontainers/kallisto@sha256:7615f563aa2948fd087f7e4a666e252f275c60b2070729bc9a3804c8873527e5'
        cpus = { Math.min(4, params.max_cpus as Integer) }
        memory = { "${Math.min(8, params.max_memory_gb as Double)} GB" }
        // Exit 240 is reserved for run_with_timeout's two-hour Kallisto limit; retry it or one native failure.
        errorStrategy = { task.exitStatus in [134, 139, 240] ? 'retry' : 'terminate' }
        maxRetries = 1
    }

    withLabel: analysis {
        // APPENDIX: 2.3
        container = 'missus-tom/rnaseq-analysis:0.3.0'
        cpus = { Math.min(4, params.max_cpus as Integer) }
        memory = { "${Math.min(16, params.max_memory_gb as Double)} GB" }
    }
}

// =============================================================================
// APPENDICES: PLAIN-ENGLISH PSEUDOCODE
// =============================================================================
// SECTION 1
// Appendix 1.1 — Give every task conservative default CPU and memory requests.
// Appendix 1.2 — Use the pinned FastQC image; allow one retry for native JVM crashes.
// Appendix 1.3 — Use the pinned MultiQC image with one CPU and bounded memory.
//
// SECTION 2
// Appendix 2.1 — Use the pinned Cutadapt image and up to four configured CPUs.
// Appendix 2.2 — Use the pinned Kallisto image, bounded resources, and one retry for timeout or native failure.
// Appendix 2.3 — Use the R-analysis image with bounded CPU and memory requests.
