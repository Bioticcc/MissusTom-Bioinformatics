/*
 * =============================================================================
 * BULK RNA-SEQ NEXTFLOW CONFIGURATION
 * =============================================================================
 * PURPOSE: Supplies workflow-wide defaults, local admission limits, execution
 * profiles, and Nextflow's timeline/report/trace paths. main.nf performs the
 * scientific work; conf/resources.config supplies per-process requirements.
 * INPUTS: command-line parameters supplied by the Missus-Tom runner.
 * OUTPUTS: scheduling settings plus execution metadata under reports/ and logs/.
 * TERMS: a profile selects an execution environment; a process is one task.
 * =============================================================================
 */

// =============================================================================
// SECTION 1: WORKFLOW IDENTITY, PARAMETERS, AND LOCAL ADMISSION LIMITS
// =============================================================================
manifest {
    // APPENDIX: 1.1
    name = 'missus-tom/bulk-rnaseq'
    version = '0.5.0'
    nextflowVersion = '>=24.04.0'
}

params {
    // APPENDIX: 1.2
    manifest = null
    outdir = 'results'
    start_stage = 'quantification'
    max_cpus = 4
    max_memory_gb = 16
    max_parallel_tasks = 1
    run_id = null
}

process {
    // APPENDIX: 1.3
    executor = 'local'
    // A native segmentation fault can be transient. Retry that task once;
    // preserve immediate failure for all actionable and intentional exits.
    errorStrategy = { task.exitStatus == 139 ? 'retry' : 'terminate' }
    maxRetries = 1
}

// These are workflow-wide admission limits for the local executor. Individual
// process requests in conf/resources.config are capped to the same values.
executor {
    // APPENDIX: 1.4
    cpus = params.max_cpus as Integer
    memory = "${params.max_memory_gb as Double} GB"
    queueSize = params.max_parallel_tasks as Integer
}

// =============================================================================
// SECTION 2: PER-PROCESS RESOURCES AND NEXTFLOW EXECUTION REPORTS
// =============================================================================
includeConfig 'conf/resources.config'
// APPENDIX: 2.1

timeline {
    // APPENDIX: 2.2
    enabled = true
    file = "${params.outdir}/../reports/timeline.html"
    overwrite = true
}

report {
    // APPENDIX: 2.3
    enabled = true
    file = "${params.outdir}/../reports/execution_report.html"
    overwrite = true
}

trace {
    // APPENDIX: 2.4
    enabled = true
    file = "${params.outdir}/../logs/trace.tsv"
    overwrite = true
}

// =============================================================================
// SECTION 3: LOCAL, DOCKER, AND APPTAINER EXECUTION PROFILES
// =============================================================================
profiles {
    // APPENDIX: 3.1
    local {
        process.executor = 'local'
        // Host tools are the normal path. Container directives in
        // conf/resources.config apply only when Docker is enabled.
        docker.enabled = false
    }

    docker {
        docker.enabled = true
        process.executor = 'local'
        docker.runOptions = '--network none'
        // Nextflow supplies --memory from each process memory directive. Set
        // hard CPU limits and prohibit extra swap for every task as well.
        process.containerOptions = {
            "--cpus ${task.cpus} --memory-swap ${task.memory.toBytes()}" +
                (params.run_id ? " --label missus_tom.run_id=${params.run_id}" : "")
        }
    }

    apptainer {
        apptainer.enabled = true
        process.executor = 'local'
    }
}

// =============================================================================
// APPENDICES: PLAIN-ENGLISH PSEUDOCODE
// =============================================================================
// SECTION 1
// Appendix 1.1 — Declare the pipeline name, version, and minimum Nextflow version.
// Appendix 1.2 — Set defaults for the manifest, output location, start stage, and local limits.
// Appendix 1.3 — Use the local executor and retry one native segmentation fault.
// Appendix 1.4 — Cap local CPU, memory, and queued tasks using the supplied limits.
//
// SECTION 2
// Appendix 2.1 — Load per-label CPU, memory, retry, and container settings.
// Appendix 2.2 — Write a timeline HTML file beside the results.
// Appendix 2.3 — Write a Nextflow execution report beside the results.
// Appendix 2.4 — Write a tab-separated task trace beside the results.
//
// SECTION 3
// Appendix 3.1 — Select local host tools, Docker with isolated networking, or Apptainer.
