manifest {
    name = 'yan-lab/missus-tom-bulk-rnaseq'
    version = '0.3.0-full-demo'
    nextflowVersion = '>=24.04.0'
}

params {
    manifest = null
    outdir = 'results'
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0
}

includeConfig 'conf/resources.config'

timeline {
    enabled = true
    file = "${params.outdir}/../reports/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/../reports/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/../logs/trace.tsv"
    overwrite = true
}

profiles {
    local {
        process.executor = 'local'
    }

    docker {
        docker.enabled = true
        process.executor = 'local'
        docker.runOptions = '--network none'
    }

    apptainer {
        apptainer.enabled = true
        process.executor = 'local'
    }
}
