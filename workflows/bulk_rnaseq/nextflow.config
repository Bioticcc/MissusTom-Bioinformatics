manifest {
    name = 'missus-tom/bulk-rnaseq'
    version = '0.4.0'
    nextflowVersion = '>=24.04.0'
}

params {
    manifest = null
    outdir = 'results'
    start_stage = 'quantification'
    max_cpus = 4
    max_memory_gb = 16
    max_parallel_tasks = 1
    run_id = null
}

process {
    executor = 'local'
    // A native segmentation fault can be transient. Retry that task once;
    // preserve immediate failure for all actionable and intentional exits.
    errorStrategy = { task.exitStatus == 139 ? 'retry' : 'terminate' }
    maxRetries = 1
}

// These are workflow-wide admission limits for the local executor. Individual
// process requests in conf/resources.config are capped to the same values.
executor {
    cpus = params.max_cpus as Integer
    memory = "${params.max_memory_gb as Double} GB"
    queueSize = params.max_parallel_tasks as Integer
}

includeConfig 'conf/resources.config'

timeline {
    enabled = true
    file = "${params.outdir}/../reports/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/../reports/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/../logs/trace.tsv"
    overwrite = true
}

profiles {
    local {
        process.executor = 'local'
        // Host tools are the normal path. Container directives in
        // conf/resources.config apply only when Docker is enabled.
        docker.enabled = false
    }

    docker {
        docker.enabled = true
        process.executor = 'local'
        docker.runOptions = '--network none'
        // Nextflow supplies --memory from each process memory directive. Set
        // hard CPU limits and prohibit extra swap for every task as well.
        process.containerOptions = {
            "--cpus ${task.cpus} --memory-swap ${task.memory.toBytes()}" +
                (params.run_id ? " --label missus_tom.run_id=${params.run_id}" : "")
        }
    }

    apptainer {
        apptainer.enabled = true
        process.executor = 'local'
    }
}
