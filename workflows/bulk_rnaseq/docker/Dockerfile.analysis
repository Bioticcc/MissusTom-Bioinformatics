# =============================================================================
# BULK RNA-SEQ R ANALYSIS CONTAINER
# =============================================================================
# PURPOSE: Defines the existing image used only by the Docker profile for the
# R analysis stage. main.nf supplies the input tables; this image provides R
# and its analysis packages. The resulting image is selected in resources.config.
# =============================================================================
# APPENDIX: 1.1
FROM bioconductor/bioconductor_docker@sha256:41ed449aa2181f330cdc8d0499a11a7435b04827ff926dc141584a34f65a12cb

# APPENDIX: 1.2
COPY bulk-rnaseq-linux-64.lock /tmp/bulk-rnaseq-linux-64.lock
RUN curl --fail --location --retry 3 \
      https://github.com/mamba-org/micromamba-releases/releases/download/2.3.2-0/micromamba-linux-64.tar.bz2 \
      --output /tmp/micromamba.tar.bz2 \
    && echo '5512233cdd8564a671626081026dc861537a963baa06706baab08fac6f3bb9d2  /tmp/micromamba.tar.bz2' | sha256sum --check - \
    && tar -xjf /tmp/micromamba.tar.bz2 -C /tmp bin/micromamba \
    && /tmp/bin/micromamba create --yes --no-rc --prefix /opt/missus-tom \
       --file /tmp/bulk-rnaseq-linux-64.lock \
    && rm -rf /tmp/bin /tmp/micromamba.tar.bz2 /root/.local/share/mamba/pkgs

ENV PATH="/opt/missus-tom/bin:${PATH}" \
    R_HOME=/opt/missus-tom/lib/R \
    R_LIBS_USER=/opt/missus-tom/lib/R/library \
    R_LIBS_SITE=/opt/missus-tom/lib/R/site-library \
    R_ENVIRON_USER=/dev/null R_PROFILE_USER=/dev/null \
    R_ENVIRON_SITE=/dev/null R_PROFILE_SITE=/dev/null

# APPENDIX: 1.3
RUN Rscript --vanilla -e 'stopifnot(requireNamespace("DESeq2", quietly = TRUE), requireNamespace("tximport", quietly = TRUE), requireNamespace("ggplot2", quietly = TRUE))'

LABEL org.opencontainers.image.title="Missus Tom bulk RNA-seq analysis"
LABEL org.opencontainers.image.version="locked-bulk-0.5.0"

# =============================================================================
# APPENDICES: PLAIN-ENGLISH PSEUDOCODE
# =============================================================================
# SECTION 1
# Appendix 1.1 — Start from the pinned Bioconductor R image.
# Appendix 1.2 — Install the exact native Bulk dependency lock with verified Micromamba.
# Appendix 1.3 — Verify the locked R analysis packages without resolving new versions.
