# =============================================================================
# BULK RNA-SEQ R ANALYSIS CONTAINER
# =============================================================================
# PURPOSE: Defines the existing image used only by the Docker profile for the
# R analysis stage. main.nf supplies the input tables; this image provides R
# and its analysis packages. The resulting image is selected in resources.config.
# =============================================================================
# APPENDIX: 1.1
FROM bioconductor/bioconductor_docker@sha256:41ed449aa2181f330cdc8d0499a11a7435b04827ff926dc141584a34f65a12cb

# APPENDIX: 1.2
RUN apt-get update \
    && apt-get install --yes --no-install-recommends r-cran-ggplot2 \
    && rm -rf /var/lib/apt/lists/*

# APPENDIX: 1.3
RUN R --vanilla -e 'options(Ncpus = 1); BiocManager::install(c("DESeq2", "tximport"), ask = FALSE, update = FALSE); stopifnot(requireNamespace("DESeq2", quietly = TRUE), requireNamespace("tximport", quietly = TRUE), requireNamespace("ggplot2", quietly = TRUE))'

LABEL org.opencontainers.image.title="Missus Tom bulk RNA-seq analysis"
LABEL org.opencontainers.image.version="0.3.0"

# =============================================================================
# APPENDICES: PLAIN-ENGLISH PSEUDOCODE
# =============================================================================
# SECTION 1
# Appendix 1.1 — Start from the pinned Bioconductor R image.
# Appendix 1.2 — Install ggplot2 and remove temporary package-list files.
# Appendix 1.3 — Install DESeq2 and tximport, then verify all required R packages exist.
