manifest {
    name = 'missus-tom/singlecell-rnaseq'
    version = '0.1.0'
    nextflowVersion = '>=24.04.0'
}
params {
    prepared_manifest = null
    outdir = 'results'
    reports_dir = null
    max_cpus = 2
    max_memory_gb = 8
}
process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxForks = 1
}
executor {
    cpus = params.max_cpus as Integer
    memory = "${params.max_memory_gb} GB"
    queueSize = 1
}
includeConfig 'conf/resources.config'
timeline {
    enabled = true
    file = params.reports_dir ? "${params.reports_dir}/timeline.html" : "${params.outdir}/../reports/timeline.html"
}
report {
    enabled = true
    file = params.reports_dir ? "${params.reports_dir}/execution_report.html" : "${params.outdir}/../reports/execution_report.html"
}
trace {
    enabled = true
    file = params.reports_dir ? "${params.reports_dir}/trace.tsv" : "${params.outdir}/../reports/trace.tsv"
}
profiles {
    local {
        process.executor = 'local'
        docker.enabled = false
    }
}
