{
  "schema_version": "singlecell-fastq-v1",
  "reference": {
    "species": "REPLACE_WITH_SPECIES",
    "genome_build": "REPLACE_WITH_BUILD_AND_ANNOTATION_RELEASE",
    "mitochondrial_gene_ids": ["REPLACE_WITH_REFERENCE_MITOCHONDRIAL_GENE_IDS"],
    "fasta": "/absolute/path/to/genome.fa",
    "gtf": "/absolute/path/to/genes.gtf",
    "sjdb_overhang": 99,
